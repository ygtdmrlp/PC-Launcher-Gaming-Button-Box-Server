<UserControl x:Class="PCLauncher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- Welcome / Getting Started Banner (Visible when no apps) -->
            <Border x:Name="WelcomeBanner" Background="#1D2A44" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="👋 PC Launcher'a Hoş Geldiniz!" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                        <TextBlock Text="Telefonunuzdan bilgisayarınızdaki programları tek tıkla açmak için ilk programınızı tanımlayın." FontSize="13" Foreground="#93C5FD" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="➕ İlk Programı Ekle" Style="{StaticResource PrimaryButton}" Click="AddFirstApp_Click" VerticalAlignment="Center" Margin="16,0,0,0" Padding="14,10" />
                </Grid>
            </Border>

            <!-- Firewall Warning Banner (If needed) -->
            <Border x:Name="FirewallBanner" Background="#332414" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Padding="16" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="🛡️ Windows Firewall İzni Gerekli" FontSize="14" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,0,4" />
                        <TextBlock Text="Telefonunuzun bağlanabilmesi için Windows Güvenlik Duvarı'nda yerel ağ erişimine izin verilmelidir." FontSize="12" Foreground="#D1D5DB" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="İzin Ver" Style="{StaticResource ModernButton}" Click="AllowFirewall_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Top Cards Grid: Server Status & Quick Controls -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Status & Network Info -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusTitleText" Text="Server Online" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <Button x:Name="ServerToggleBtn" Grid.Column="1" Content="⏹ Server'ı Durdur" Style="{StaticResource ModernButton}" Click="ServerToggle_Click" />
                        </Grid>

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,10" />

                        <!-- IP Selector -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Yerel IP:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox x:Name="IpComboBox" Grid.Column="1" SelectionChanged="IpComboBox_SelectionChanged" />
                        </Grid>

                        <!-- Port -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock x:Name="PortText" Grid.Column="1" Text="5000" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Mobile URL Box -->
                        <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📱 Telefon Web Adresi" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UrlText" Text="http://192.168.1.25:5000" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="CopyUrlBtn" Content="📋 Kopyala" Style="{StaticResource ModernButton}" Click="CopyUrl_Click" Padding="10,6" Margin="0,0,6,0" />
                                    <Button x:Name="OpenBrowserBtn" Content="🌐 Aç" Style="{StaticResource ModernButton}" Click="OpenBrowser_Click" Padding="10,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Stats -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#121826" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Program Sayısı" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="AppsCountText" Text="0" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#121826" CornerRadius="8" Padding="10" Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Aktif Cihazlar" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="ConnectedClientsText" Text="0" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#121826" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PIN Durumu" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="PinStatusText" Text="Kapalı" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: QR Code -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📱 Telefon Bağlantısı" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        
                        <Border Background="#FFFFFF" Padding="12" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image x:Name="QrCodeImage" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>

                        <TextBlock Text="Telefon kamerasını QR koda tutarak launcher'ı doğrudan açın." 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Card: Live Activity Logs -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 Canlı Sistem &amp; İstek Logları" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="LogsCountText" Text="(0 kayıt)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Temizle" Style="{StaticResource ModernButton}" Click="ClearLogs_Click" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Kopyala" Style="{StaticResource ModernButton}" Click="CopyLogs_Click" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#0C101A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ListBox x:Name="LogsListBox" Background="Transparent" BorderThickness="0" Foreground="#A7B3C6"
                                 FontFamily="Consolas, Cascadia Code, monospace" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
