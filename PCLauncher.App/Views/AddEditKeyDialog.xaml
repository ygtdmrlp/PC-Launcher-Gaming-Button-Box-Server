<Window x:Class="PCLauncher.App.Views.AddEditKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oyun Tuşu Tanımla" Height="620" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitleText" Text="Oyun Tuşu Ekle (Button Box)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Telefonda tek dokunuşla basılacak klavye tuşunu veya kısayolu yapılandırın." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">

                    <!-- Button Title & Category Grid -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <StackPanel>
                            <TextBlock Text="Buton Başlığı *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TitleTextBox" TextChanged="Form_Changed" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Oyun / Kategori" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CategoryComboBox" IsEditable="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Key Sequence (Shortcut / Key) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Basılacak Tuş veya Kısayol *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyTextBox" TextChanged="Form_Changed" Tag="Örn: L, Space, Ctrl+Shift+S, F12" />
                            <ComboBox x:Name="QuickKeysCombo" Grid.Column="2" Width="120" SelectionChanged="QuickKeysCombo_SelectionChanged" />
                        </Grid>
                        <TextBlock Text="Desteklenenler: A-Z, 0-9, Space, Enter, Esc, F1-F12, [, ], Ctrl, Shift, Alt, NumPad, Yön Tuşları" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Hold Duration (Key Press Hold Time) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Basılı Tutma Süresi (ETS2 / DirectInput)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Oyunun tuşu kaçırmaması için basılı kalma süresi." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="HoldDurationComboBox" Grid.Column="2" VerticalAlignment="Center">
                            <ComboBoxItem Content="100 ms (Standart Oyun / ETS2)" Tag="100" IsSelected="True" />
                            <ComboBoxItem Content="200 ms (Güvenli Basış)" Tag="200" />
                            <ComboBoxItem Content="500 ms (Marş / Uzun Basış)" Tag="500" />
                            <ComboBoxItem Content="1000 ms (1 Saniye)" Tag="1000" />
                        </ComboBox>
                    </Grid>

                    <!-- Icon Selection -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Buton İkonu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Preset Emoji Icons -->
                            <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,10">
                                <!-- Populated dynamically or inline -->
                            </WrapPanel>

                            <!-- Custom Image Option -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Veya kendi ikon resminizi (.png, .jpg, .ico) yükleyin:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="📁 Özel Resim Seç..." Style="{StaticResource ModernButton}" Click="BrowseCustomIcon_Click" Padding="8,4" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Button Color Selection -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Buton Neon Rengi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <WrapPanel x:Name="ColorsPanel">
                                <!-- Color pills -->
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Mobile Preview -->
                    <Border Background="#0C101A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📱 Mobil Tuş Önizlemesi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            
                            <!-- Simulated Deck Button -->
                            <Border x:Name="PreviewBtnBorder" Width="100" Height="100" CornerRadius="16" BorderThickness="2" BorderBrush="#3B82F6" Background="#151B29" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Icon -->
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PreviewPresetIconText" Text="💡" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="PreviewCustomIconImage" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Title -->
                                    <TextBlock x:Name="PreviewTitleText" Grid.Row="1" Text="Farlar" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />

                                    <!-- Key Badge -->
                                    <Border Grid.Row="2" Background="#0A0D14" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PreviewKeyBadgeText" Text="[L]" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Style="{StaticResource ModernButton}" Click="Cancel_Click" Width="90" Margin="0,0,10,0" />
                    <Button Content="💾 Kaydet" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="110" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
