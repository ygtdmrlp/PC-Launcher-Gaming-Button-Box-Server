<Window x:Class="PCLauncher.App.Views.AddEditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Tanımla" Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="DialogTitleText" Text="Program Ekle" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Bilgisayarınızda uzaktan başlatmak istediğiniz programı seçin." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">

                    <!-- Exe Path & Browse -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="EXE Dosyası (*.exe) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExePathTextBox" TextChanged="ExePathTextBox_TextChanged" />
                            <Button Grid.Column="2" Content="📁 Gözat..." Style="{StaticResource ModernButton}" Click="BrowseExe_Click" Padding="12,8" />
                        </Grid>
                    </StackPanel>

                    <!-- Program Name -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Program Adı *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="NameTextBox" />
                    </StackPanel>

                    <!-- Icon Preview & Selector -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="52" Height="52" Background="#101522" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                <Image x:Name="IconPreviewImage" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Program İkonu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="EXE dosyasından otomatik çekilir veya özel resim seçilebilir." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🖼️ Özel İkon Seç" Style="{StaticResource ModernButton}" Click="CustomIcon_Click" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                    <Button Content="Sıfırla" Style="{StaticResource ModernButton}" Click="ResetIcon_Click" Padding="8,4" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Category & Order in Grid -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel>
                            <TextBlock Text="Kategori" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CategoryComboBox" IsEditable="True" />
                        </StackPanel>

                        <!-- Order -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Görünüm Sırası" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="OrderTextBox" Text="0" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Açıklama (İsteğe Bağlı)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="DescriptionTextBox" />
                    </StackPanel>

                    <!-- Arguments -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Çalıştırma Parametreleri / Argümanlar (İsteğe Bağlı)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="ArgumentsTextBox" />
                    </StackPanel>

                    <!-- Favorite Checkbox -->
                    <CheckBox x:Name="IsFavoriteCheckBox" Content="⭐ Telefonda favoriler listesine ekle" Margin="0,4,0,0" />

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Style="{StaticResource ModernButton}" Click="Cancel_Click" Width="90" Margin="0,0,10,0" />
                    <Button Content="💾 Kaydet" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="110" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
